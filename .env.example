# Copy to .env, set WALLET_ADDRESS, then: docker compose up -d

# REQUIRED: your own ParanO(1)d address (o1…). Your blocks pay it directly;
# your wallet keys never go into the container.
WALLET_ADDRESS=

# Port your rigs connect to: stratum+tcp://<this-host>:3333
STRATUM_PORT=3333

# Node P2P port. Forward it (TCP) in your router: inbound peers bring new
# blocks to your node sooner, which means less wasted work.
P2P_PORT=9600

# Public IP of this machine, if you forwarded P2P_PORT in your router. The node
# then announces itself, other nodes connect to it and new blocks reach you
# sooner. Leave empty without a port forwarding.
PUBLIC_ADDRESS=

# Outbound P2P peers the node keeps (8-16). More peers bring new blocks to
# your node sooner.
P2P_PEERS=16

# Dashboard in the browser: http://<this-host>:9640 . Only this machine by
# default; 0.0.0.0 makes it reachable from your LAN.
STATS_BIND_HOST=127.0.0.1

# CPU threads for the node's block proofs. Empty = all cores (recommended on
# a machine that does nothing else).
NODE_THREADS=

# Seconds between status lines in the log.
STATUS_INTERVAL=60

# Optional TLS for rigs that connect over the internet. Needs a certificate
# for a real host name (self-signed certificates are refused by miners that
# check them). Put both PEM files into the data volume and enable:
# TLS_ENABLED=true
# TLS_CERT=/data/tls/fullchain.pem
# TLS_KEY=/data/tls/privkey.pem
# (and publish port 3334 in docker-compose.yml)
